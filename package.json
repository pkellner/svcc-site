{
  "name": "svcc-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build:static": "TZ=UTC SHOW_ALL_EVENTS=true next build --webpack && sh scripts/prune-out.sh && node scripts/legacy-speaker-pages.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/og-card/make-page-cards.mjs",
    "build:gh-pages": "TZ=UTC SHOW_ALL_EVENTS=true next build --webpack && sh scripts/prune-out.sh && node scripts/legacy-speaker-pages.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/og-card/make-page-cards.mjs",
    "test:gh-pages": "node scripts/test-gh-pages.mjs",
    "test:gh-pages:local": "node scripts/test-gh-pages.mjs --local",
    "test:meta": "node scripts/test-meta.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "test:browser:local": "GH_PAGES_URL=http://127.0.0.1:8787 BROWSER_SAMPLE=all BROWSER_CONCURRENCY=8 node scripts/test-gh-pages-browser.mjs",
    "test:gh-pages:browser": "node scripts/test-gh-pages-browser.mjs",
    "test:static:local": "NEXT_PUBLIC_BASE_PATH= node scripts/test-gh-pages.mjs --local",
    "test:static": "NEXT_PUBLIC_BASE_PATH= GH_PAGES_URL=${PAGES_URL:-https://siliconvalley-codecamp.com} node scripts/test-gh-pages.mjs",
    "test:static:browser": "NEXT_PUBLIC_BASE_PATH= GH_PAGES_URL=${PAGES_URL:-https://siliconvalley-codecamp.com} node scripts/test-gh-pages-browser.mjs",
    "home-data": "node scripts/build-home-data.mjs",
    "og-card": "node scripts/og-card/make-og-card.mjs",
    "og-pages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/og-card/make-page-cards.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup": "npm install && npx playwright install chromium"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "bootstrap": "^5.3.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.9.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "sass": "^1.84.0",
    "typescript": "^5.9.3"
  }
}
